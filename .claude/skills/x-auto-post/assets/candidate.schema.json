{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {"type": "string", "enum": ["post", "skip"]},
    "reason": {"type": "string"},
    "topic": {"type": "string"},
    "text": {"type": "string"},
    "event_key": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string"},
          "title": {"type": "string"},
          "checked_at": {"type": "string"}
        },
        "required": ["url", "title", "checked_at"]
      }
    },
    "valid_until": {"type": "string"},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string"},
          "alt_text": {"type": "string"},
          "rights": {"type": "string", "enum": ["owned", "public_domain", "cc0", "licensed"]},
          "rights_url": {"type": "string"}
        },
        "required": ["url", "alt_text", "rights", "rights_url"]
      }
    }
  },
  "required": ["action", "reason", "topic", "text", "event_key", "sources", "valid_until", "images"]
}
