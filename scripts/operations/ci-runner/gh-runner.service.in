[Unit]
Description=GitHub Actions runner @NAME@ for sixianli/himawari-agent
Wants=network-online.target
After=network-online.target gh-runner-nft.service
Requires=gh-runner-nft.service

[Service]
Type=simple
Slice=@SLICE@
User=@USER@
Group=@USER@
SupplementaryGroups=@SHARE_GROUP@
WorkingDirectory=@ROOT@/runner
ExecStart=@ROOT@/runner/bin/runsvc.sh
Restart=always
RestartSec=15
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5min
Environment=HOME=@ROOT@/home
Environment=HIMAWARI_CI_SHARE=@SHARE@
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=@ROOT@/hooks/job-started.sh
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED=@ROOT@/hooks/job-completed.sh
UMask=0022
MemoryMin=@MEMORY_MIN@
MemoryHigh=@MEMORY_HIGH@
MemoryMax=@MEMORY_MAX@
MemorySwapMax=0
TasksMax=@TASKS_MAX@
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ReadWritePaths=@ROOT@/runner @ROOT@/home @ROOT@/logs @SHARE@
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock@OTHER_ROOTS@

[Install]
WantedBy=multi-user.target
