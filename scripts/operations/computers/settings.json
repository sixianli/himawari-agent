{
  "gvisor": {
    "release": "20261123.1",
    "url": "https://storage.googleapis.com/gvisor/releases/release/{release}/{arch}/gvisor.tar.bz2",
    "sha512": {
      "aarch64": "930967c01eaa8c91a90903ba866070dd165c580d3197287747bb1444ee11dab7350db11d8f90bf00efb2cdcfb2318602d3f329c522c9e9436a86fe6a93c7b7fc"
    }
  },
  "image": {
    "repository": "himawari-computer"
  },
  "paths": {
    "config": "/etc/himawari-computers/config.json",
    "unit": "/etc/systemd/system/himawari-computers.service",
    "stateDirectory": "/var/lib/himawari-computers",
    "socket": "/run/himawari-computers/computers.sock",
    "runtimeRoots": ["/opt/himawari/releases"],
    "seedRoots": ["/var/lib/himawari/workspace"],
    "node": "/opt/himawari/node/bin/node",
    "docker": "/usr/bin/docker"
  },
  "serviceGroup": "himawari-prod",
  "computer": {
    "runtime": "runsc",
    "disk": { "mode": "loop", "sizeBytes": 10737418240 },
    "resources": { "memoryBytes": 2147483648, "cpus": 1, "maxProcesses": 512 },
    "admission": {
      "startBytes": 536870912,
      "reserveBytes": 4294967296,
      "waitMs": 120000,
      "pollMs": 2000
    },
    "idle": { "stopAfterMs": 900000, "checkIntervalMs": 60000, "staleAfterMs": 2592000000 },
    "commandTimeoutMs": 60000,
    "stopGraceSeconds": 5,
    "beforeStop": { "argv": ["himawari-browser", "stop"], "timeoutSeconds": 10 }
  }
}
