{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "events",
    "defaultBranch",
    "checks",
    "testProjects",
    "registeredTests",
    "retentionDays"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
        "enum": ["pull_request", "push", "workflow_dispatch"]
      },
      "minItems": 3
    },
    "defaultBranch": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "needs", "timeoutMinutes", "members", "projects", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "runner", "os", "arch", "node"],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "runner": {
                  "enum": ["ci-vps", "ci-vps-gate", "ci-arm", "macos-15"]
                },
                "paused": {
                  "const": true
                },
                "os": {
                  "enum": ["linux", "darwin"]
                },
                "arch": {
                  "enum": ["x64", "arm64"]
                },
                "alternateArch": {
                  "const": "arm64"
                },
                "node": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "browser": {
                  "enum": ["chromium", "firefox", "webkit"]
                },
                "projects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "shard": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["index", "count"],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 2
                    }
                  }
                }
              }
            },
            "minItems": 1
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 7
    },
    "testProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "include", "exclude", "fileParallelism"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "fileParallelism": {
            "type": "boolean"
          },
          "workerLimits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maximum", "cpusPerWorker", "memoryMiBPerWorker"],
            "properties": {
              "maximum": { "type": "integer", "minimum": 1, "maximum": 4 },
              "cpusPerWorker": { "type": "integer", "minimum": 1 },
              "memoryMiBPerWorker": { "type": "integer", "minimum": 2048 }
            }
          }
        }
      },
      "minItems": 6
    },
    "registeredTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "project", "reason", "allowedModifiers"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["qualification", "child-fixture", "type-check"]
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "allowedModifiers": {
            "type": "array",
            "items": {
              "enum": ["skip", "skipIf", "runIf", "todo"]
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "retentionDays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reports", "diagnostics"],
      "properties": {
        "reports": {
          "const": 1
        },
        "diagnostics": {
          "const": 1
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckPolicy"
}
