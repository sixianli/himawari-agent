{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CI evidence handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "context",
    "defaultBranch",
    "runUrl",
    "createdAt",
    "securityScannedAt",
    "expiresAt",
    "status",
    "productQualification",
    "persistence",
    "platforms",
    "checks",
    "pending"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ci-evidence"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "event",
        "runId",
        "attempt",
        "testedSha",
        "headSha",
        "baseSha",
        "policySha256",
        "toolchainSha256",
        "initialization"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "event": {
          "enum": ["pull_request", "push", "workflow_dispatch"]
        },
        "runId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "testedSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "toolchainSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "initialization": {
          "type": "boolean"
        }
      }
    },
    "defaultBranch": {
      "const": "main"
    },
    "runUrl": {
      "type": "string",
      "pattern": "^https://github.com/[^/]+/[^/]+/actions/runs/[1-9][0-9]*$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "securityScannedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "status": {
      "const": "ci_verified"
    },
    "productQualification": {
      "const": "not_assessed"
    },
    "persistence": {
      "const": "transfer_required_before_expiry"
    },
    "platforms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "archiveSha256", "reportSha256"],
        "properties": {
          "platform": {
            "enum": ["linux-x64", "macos-arm64"]
          },
          "archiveSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reportSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "matrixKey", "reportSha256"],
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "matrixKey": {
            "type": "string",
            "minLength": 1
          },
          "reportSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "pending": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
