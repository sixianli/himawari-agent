{
  "schemaVersion": 1,
  "events": ["pull_request", "push", "workflow_dispatch"],
  "defaultBranch": "main",
  "checks": [
    {
      "id": "policy",
      "needs": [],
      "timeoutMinutes": 60,
      "members": [
        {
          "key": "default",
          "runner": "ubuntu-24.04-arm",
          "os": "linux",
          "arch": "x64",
          "alternateArch": "arm64",
          "node": "22.22.3"
        }
      ],
      "projects": [],
      "outputs": ["json"]
    },
    {
      "id": "static",
      "needs": ["policy"],
      "timeoutMinutes": 60,
      "members": [
        {
          "key": "default",
          "runner": "ubuntu-24.04",
          "os": "linux",
          "arch": "x64",
          "node": "22.22.3"
        }
      ],
      "projects": [],
      "outputs": ["json"]
    },
    {
      "id": "build",
      "needs": ["policy"],
      "timeoutMinutes": 90,
      "members": [
        {
          "key": "linux-x64",
          "runner": "ubuntu-24.04",
          "os": "linux",
          "arch": "x64",
          "node": "22.22.3"
        },
        {
          "key": "macos-arm64",
          "runner": "macos-26",
          "os": "darwin",
          "arch": "arm64",
          "node": "22.22.3",
          "paused": true
        }
      ],
      "projects": [],
      "outputs": ["json", "artifact"]
    },
    {
      "id": "tests",
      "needs": ["policy", "build"],
      "timeoutMinutes": 60,
      "members": [
        {
          "key": "integration-1",
          "runner": "ubuntu-24.04",
          "os": "linux",
          "arch": "x64",
          "node": "22.22.3",
          "projects": ["integration"],
          "shard": {
            "index": 1,
            "count": 2
          }
        },
        {
          "key": "integration-2",
          "runner": "ubuntu-24.04",
          "os": "linux",
          "arch": "x64",
          "node": "22.22.3",
          "projects": ["integration"],
          "shard": {
            "index": 2,
            "count": 2
          }
        },
        {
          "key": "others",
          "runner": "ubuntu-24.04",
          "os": "linux",
          "arch": "x64",
          "node": "22.22.3",
          "projects": ["unit", "contracts", "e2e", "pi-compat"]
        }
      ],
      "projects": ["unit", "contracts", "integration", "e2e", "pi-compat"],
      "outputs": ["json", "artifact"]
    },
    {
      "id": "tooling",
      "needs": ["policy"],
      "timeoutMinutes": 60,
      "members": [
        {
          "key": "default",
          "runner": "ubuntu-24.04-arm",
          "os": "linux",
          "arch": "x64",
          "alternateArch": "arm64",
          "node": "22.22.3"
        }
      ],
      "projects": ["tooling"],
      "outputs": ["json"]
    },
    {
      "id": "security",
      "needs": ["policy"],
      "timeoutMinutes": 60,
      "members": [
        {
          "key": "default",
          "runner": "ubuntu-24.04-arm",
          "os": "linux",
          "arch": "x64",
          "alternateArch": "arm64",
          "node": "22.22.3"
        }
      ],
      "projects": [],
      "outputs": ["json"]
    },
    {
      "id": "required",
      "needs": ["policy", "static", "build", "tests", "tooling", "security"],
      "timeoutMinutes": 15,
      "members": [
        {
          "key": "default",
          "runner": "ubuntu-24.04",
          "os": "linux",
          "arch": "x64",
          "node": "22.22.3"
        }
      ],
      "projects": [],
      "outputs": []
    }
  ],
  "testProjects": [
    {
      "id": "unit",
      "include": ["apps/**/*.unit.test.ts", "packages/**/*.unit.test.ts"],
      "exclude": [],
      "fileParallelism": true
    },
    {
      "id": "contracts",
      "include": ["apps/**/*.contract.test.ts", "packages/**/*.contract.test.ts"],
      "exclude": [],
      "fileParallelism": true
    },
    {
      "id": "integration",
      "include": ["test/integration/**/*.test.ts"],
      "exclude": [
        "test/integration/scale-qualification.test.ts",
        "test/integration/thread-scale-qualification.test.ts",
        "test/integration/openrouter-generation-live.test.ts",
        "test/integration/openrouter-embedding-live.test.ts",
        "test/integration/jarvis-test/live-round.test.ts",
        "test/integration/memory-retrieval-eval/live.test.ts",
        "test/integration/memory-benchmark/live.test.ts",
        "test/integration/container-execution-backend-qualification.test.ts",
        "test/integration/container-runtime-restart-qualification.test.ts",
        "test/integration/container-browser-qualification.test.ts",
        "test/integration/container-pi-runner-qualification.test.ts",
        "test/integration/product-path-browser.test.ts",
        "test/integration/browser-tool-real-sites.test.ts"
      ],
      "fileParallelism": true,
      "workerLimits": {
        "maximum": 3,
        "cpusPerWorker": 1,
        "memoryMiBPerWorker": 2048
      }
    },
    {
      "id": "e2e",
      "include": ["test/e2e/**/*.test.ts"],
      "exclude": [],
      "fileParallelism": true
    },
    {
      "id": "pi-compat",
      "include": ["packages/runtime-pi/**/*.compat.test.ts"],
      "exclude": [],
      "fileParallelism": true
    },
    {
      "id": "tooling",
      "include": ["test/tooling/**/*.test.ts", "test/tooling/**/*.test.mjs"],
      "exclude": [],
      "fileParallelism": true
    }
  ],
  "registeredTests": [
    {
      "path": "test/integration/scale-qualification.test.ts",
      "kind": "qualification",
      "project": "qualification-scale",
      "reason": "规模资格依赖显式 opt-in 与固定数据输出",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/thread-scale-qualification.test.ts",
      "kind": "qualification",
      "project": "qualification-thread-scale",
      "reason": "线程规模资格依赖显式 opt-in 与固定数据输出",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/openrouter-generation-live.test.ts",
      "kind": "qualification",
      "project": "qualification-generation-live",
      "reason": "真实生成 provider 需要单独凭据与授权",
      "allowedModifiers": ["skipIf"]
    },
    {
      "path": "test/integration/jarvis-test/live-round.test.ts",
      "kind": "qualification",
      "project": "qualification-jarvis-live",
      "reason": "Jarvis Test 真模型评测需要 AI Gateway 密钥并产生费用，只在显式运行时执行",
      "allowedModifiers": ["skipIf"]
    },
    {
      "path": "test/integration/memory-retrieval-eval/live.test.ts",
      "kind": "qualification",
      "project": "qualification-memory-retrieval-live",
      "reason": "记忆检索评测要调用真实向量模型并产生少量费用，只在显式运行时执行",
      "allowedModifiers": ["skipIf"]
    },
    {
      "path": "test/integration/memory-benchmark/live.test.ts",
      "kind": "qualification",
      "project": "qualification-memory-benchmark-live",
      "reason": "LoCoMo 和 LongMemEval 记忆基准要逐轮调用真实模型并产生费用，只在显式运行时执行",
      "allowedModifiers": ["skipIf"]
    },
    {
      "path": "test/integration/openrouter-embedding-live.test.ts",
      "kind": "qualification",
      "project": "qualification-embedding-live",
      "reason": "真实向量 provider 需要单独凭据与授权",
      "allowedModifiers": ["skipIf"]
    },
    {
      "path": "test/integration/container-execution-backend-qualification.test.ts",
      "kind": "qualification",
      "project": "qualification-container",
      "reason": "真实容器运行时的资格验证依赖显式 opt-in 与可用的 Docker 兼容运行时",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/container-runtime-restart-qualification.test.ts",
      "kind": "qualification",
      "project": "qualification-container-restart",
      "reason": "重启容器运行时会中断同一台机器上的其他容器，只能单独 opt-in 并由调用方给出重启命令",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/container-browser-qualification.test.ts",
      "kind": "qualification",
      "project": "qualification-container-browser",
      "reason": "真实浏览器测试样例需要单独构建的浏览器镜像和联网出口，只能单独 opt-in",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/container-pi-runner-qualification.test.ts",
      "kind": "qualification",
      "project": "qualification-container-runner",
      "reason": "容器内 Pi runner 需要已构建的 runtime 和本机构建的 runner 镜像，只能单独 opt-in",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/product-path-browser.test.ts",
      "kind": "qualification",
      "project": "qualification-product-path",
      "reason": "产品路径浏览器 E2E 需要已构建的安装包、本机 Chrome 和沙箱运行时，单次运行十几分钟，只能单独 opt-in",
      "allowedModifiers": ["skip"]
    },
    {
      "path": "test/integration/browser-tool-real-sites.test.ts",
      "kind": "qualification",
      "project": "qualification-browser-real-sites",
      "reason": "浏览器工具访问 en.wikipedia.org、example.com 等真实外网，外网慢或改版会让和本 PR 无关的合并被拦；只在 main 推送后由 real-sites.yml 跑，失败在合进来的 PR 上留言认领",
      "allowedModifiers": []
    },
    {
      "path": "test/fixtures/durable-phase-child.test.ts",
      "kind": "child-fixture",
      "project": "child-fixture",
      "reason": "由 integration 父测试启动的隔离子进程夹具",
      "allowedModifiers": []
    },
    {
      "path": "test/fixtures/execution-uds-child.test.ts",
      "kind": "child-fixture",
      "project": "child-fixture",
      "reason": "由 integration 父测试启动的隔离子进程夹具",
      "allowedModifiers": []
    },
    {
      "path": "test/fixtures/sqlite-transaction-child.test.ts",
      "kind": "child-fixture",
      "project": "child-fixture",
      "reason": "由 integration 父测试启动的隔离子进程夹具",
      "allowedModifiers": []
    },
    {
      "path": "test/fixtures/execution-agent-child.test.ts",
      "kind": "child-fixture",
      "project": "child-fixture",
      "reason": "由 integration 父测试启动的隔离子进程夹具",
      "allowedModifiers": []
    },
    {
      "path": "packages/domain/test/identifiers.type-test.ts",
      "kind": "type-check",
      "project": "typecheck",
      "reason": "由 tsc 执行的类型拒绝断言，不属于 Vitest 运行测试",
      "allowedModifiers": []
    }
  ],
  "retentionDays": {
    "reports": 1,
    "diagnostics": 1
  }
}
