{
  "name": "himawari-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:browser && npm run build:artifacts",
    "build:artifacts": "node scripts/generate-artifact-manifest.mjs",
    "build:browser": "npm run build --workspace @himawari-agent/control-center && node scripts/check-control-center-build.mjs",
    "build:cli": "npm run build:node",
    "build:contracts": "tsc -p packages/gateway-contracts/tsconfig.build.json && tsc -p packages/execution-contracts/tsconfig.build.json",
    "build:node": "tsc -p tsconfig.node-build.json && node scripts/package-node-runtime.mjs",
    "build:services": "npm run build:node",
    "install:node-runtime": "node scripts/install-node-runtime.mjs",
    "qualify:scale": "node scripts/ci/quality.mjs --check scale --tools .ci-output/tools",
    "qualify:thread-scale": "node scripts/ci/quality.mjs --check thread-scale --tools .ci-output/tools",
    "qualify:container": "node scripts/ci/quality.mjs --check container --tools .ci-output/tools",
    "check": "node scripts/run-all-checks.mjs",
    "check:steps": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:v0.2-coverage && npm run check:v0.2-invariants && npm run check:secrets && npm run check:ci-policy && npm run check:release-walkthrough && npm run check:answer-weight && npm run check:layer0-hooks && npm run check:incident-gates && npm run check:glossary && npm run check:instruction-links && npm run check:phone-layout && npm run check:layout && npm run check:brand && npm run check:locale && npm run check:expensive-models && npm run check:egress-redaction && npm run check:prompt-prefix && npm run check:model-ref-contract && npm run check:memory-relevance && npm run check:real-admission && npm run check:audit-schema-range && npm run check:settings-scope && npm run check:source-mode-imports && npm run check:admin-schema-range",
    "check:answer-weight": "vitest run --config vitest.workspace.ts --project tooling test/tooling/answer-font-weight.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:incident-gates": "node scripts/check-incident-gates.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:real-admission": "node scripts/check-real-admission-tests.mjs",
    "check:audit-schema-range": "node scripts/check-audit-schema-range.mjs",
    "check:settings-scope": "node scripts/check-settings-scope.mjs",
    "check:source-mode-imports": "node scripts/check-source-mode-imports.mjs",
    "check:admin-schema-range": "vitest run --config vitest.workspace.ts --project integration test/integration/sandbox-reservation-administration.test.ts -t ADMIN-SCHEMA-RANGE",
    "check:memory-relevance": "node scripts/check-memory-relevance.mjs",
    "check:egress-redaction": "node scripts/check-egress-redaction.mjs",
    "check:prompt-prefix": "node scripts/check-prompt-prefix.mjs",
    "check:model-ref-contract": "vitest run --config vitest.workspace.ts --project unit apps/agent-service/test/model-ref-contract.unit.test.ts",
    "check:expensive-models": "node scripts/check-expensive-models.mjs",
    "check:locale": "node scripts/check-control-center-locale.mjs",
    "check:phone-layout": "node scripts/check-phone-layout.mjs",
    "check:layout": "node scripts/check-layout-audit.mjs",
    "check:brand": "node scripts/check-brand-assets.mjs",
    "check:layer0-hooks": "node scripts/check-layer0-hooks.mjs",
    "check:release-walkthrough": "vitest run --config vitest.workspace.ts --project browser --project tooling apps/control-center/test/release-walkthrough.unit.test.ts test/tooling/release-walkthrough-locators.test.mjs",
    "check:local-pi": "node scripts/check-local-pi.mjs",
    "check:pi-compat": "vitest run --config vitest.workspace.ts --project pi-compat",
    "check:secrets": "node scripts/scan-machine-secrets.mjs",
    "check:v0.2-coverage": "node scripts/check-v0.2-coverage.mjs",
    "check:v0.2-invariants": "node scripts/check-v0.2-invariants.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings --diagnostic-level=warn .",
    "link:local-pi": "node scripts/link-local-pi.mjs",
    "test": "node scripts/ci/local.mjs --check test",
    "test:browser": "vitest run --config vitest.workspace.ts --project browser",
    "test:cli": "vitest run --config vitest.workspace.ts --project admin-cli",
    "test:contracts": "vitest run --config vitest.workspace.ts --project contracts",
    "test:e2e": "vitest run --config vitest.workspace.ts --project e2e",
    "test:integration": "vitest run --config vitest.workspace.ts --project integration",
    "test:journeys": "vitest run --config vitest.workspace.ts --project integration test/integration/journeys",
    "test:services": "vitest run --config vitest.workspace.ts --project node-services",
    "test:unit": "vitest run --config vitest.workspace.ts --project unit",
    "test:workspace-scaffolds": "vitest run --config vitest.workspace.ts --project workspace-scaffolds",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/control-center/tsconfig.json",
    "unlink:local-pi": "node scripts/unlink-local-pi.mjs",
    "test:tooling": "node scripts/ci/local.mjs --check policy",
    "check:ci-policy": "node scripts/ci/check-policy.mjs",
    "ci:local": "node scripts/ci/local.mjs",
    "ci:tools": "node scripts/ci/install-tools.mjs --directory .ci-output/tools",
    "ci:install": "node scripts/ci/install-dependencies.mjs --tools .ci-output/tools --evidence .ci-output/installation",
    "eval:jarvis": "vitest run --config vitest.workspace.ts --project integration --project tooling test/integration/jarvis-test test/tooling/jarvis-test-history.test.mjs",
    "eval:jarvis:live": "node scripts/jarvis-test/live.mjs",
    "eval:jarvis:trend": "node scripts/jarvis-test/trend.mjs",
    "eval:memory-retrieval": "node scripts/memory-retrieval-eval/live.mjs",
    "check:instruction-links": "node scripts/check-instruction-links.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.3.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.9",
    "ajv": "8.20.0",
    "jsdom": "27.4.0",
    "rolldown": "1.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "yaml": "2.8.3"
  }
}
