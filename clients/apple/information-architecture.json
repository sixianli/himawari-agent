  "groups": [
    {
      "id": "files",
      "why": "照片和文件是这段对话自己的东西，和信息、WhatsApp 一样放在头像下面第一行，不和设置混在一组"
    },
    {
      "id": "using",
      "why": "用 Himawari 时会想调的：它怎么待我、什么时候找我、怎么跟它说话、它能看到什么"
    },
    {
      "id": "guarding",
      "why": "管住它、保护自己的：密码、收回授权、带走或删掉数据、断开这台 iPhone"
    },
    {
      "id": "about",
      "why": "版本和服务器状况，和 iOS 设置里“关于”一样单独放最后"
    }
  ],
  "entries": [
