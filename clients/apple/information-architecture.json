{
  "goals": [
    { "id": "G1", "text": "找对话里发过的照片、文件" },
    {
      "id": "G2",
      "text": "告诉 Himawari 我是谁、要它怎么做事；看和改它记住了我什么，或让它别再记"
    },
    { "id": "G3", "text": "管 Himawari 什么时候来找我" },
    { "id": "G4", "text": "用声音和 Himawari 说话" },
    { "id": "G5", "text": "管 Himawari 能碰我哪些数据和账号" },
    { "id": "G6", "text": "看和管 Himawari 替我保管的密码" },
    { "id": "G7", "text": "把我的数据带走、导入，或删掉" },
    { "id": "G8", "text": "看这台 iPhone 连着哪台服务器、断开" },
    { "id": "G9", "text": "看版本" },
    { "id": "G10", "text": "收回我点过的“以后都行”" }
