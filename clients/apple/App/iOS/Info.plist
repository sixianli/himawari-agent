<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
		<string>ja</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Himawari</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>himawari</string>
			</array>
		</dict>
	</array>
	<key>HimawariAppGroup</key>
	<string>$(HIMAWARI_APP_GROUP)</string>
	<key>HimawariKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(HIMAWARI_KEYCHAIN_GROUP)</string>
	<key>HimawariReleaseChannel</key>
	<string>$(HIMAWARI_RELEASE_CHANNEL)</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>你让 Himawari 定闹钟时，用 Himawari 自己的闹钟按时叫你</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>你让 Himawari 加、改、删日历里的事时，先读一遍再动手，做完读回来确认</string>
	<key>NSContactsUsageDescription</key>
	<string>你让 Himawari 改联系人的电话或邮箱时使用</string>
	<key>NSHomeKitUsageDescription</key>
	<string>你让 Himawari 开关家里的灯、调空调时使用</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>你让 Himawari 在提醒事项里加一条或勾掉时使用</string>
	<key>NSCameraUsageDescription</key>
	<string>扫电脑上 Himawari 设置里的配对码</string>
	<key>NSFaceIDUsageDescription</key>
	<string>改动 Himawari 里的设置和记忆前确认是你本人</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>你点“开始听”后，听周围的话并在这台 iPhone 上转成字；录音转完就删</string>
	<key>NSMotionUsageDescription</key>
	<string>判断 AirPods 是不是戴在耳朵上，好知道是不是你在叫它</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>在这台 iPhone 上把听到的话转成字</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
