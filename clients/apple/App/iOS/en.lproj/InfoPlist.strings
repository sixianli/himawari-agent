"NSCameraUsageDescription" = "Scan the pairing code shown in Himawari settings on your computer, and take a photo to show Himawari when you tap Camera under +.";
"NSFaceIDUsageDescription" = "Confirm it is you before changing Himawari settings or memories.";
"NSAlarmKitUsageDescription" = "When you ask Himawari to set an alarm, it uses its own alarm to wake you on time.";
"NSCalendarsFullAccessUsageDescription" = "When you ask Himawari to add, change, or delete calendar events, it reads them first and checks again afterward. With Calendar sensing on, it also syncs your events to your own server, and events deleted in Calendar are deleted there too.";
"NSContactsUsageDescription" = "Used when you ask Himawari to change a contact's phone number or email. With Contacts sensing on, it also syncs names, phone numbers, emails and birthdays to your own server so it knows the people you know.";
"NSHomeKitUsageDescription" = "Used when you ask Himawari to turn your lights on or off or adjust the air conditioner.";
"NSRemindersFullAccessUsageDescription" = "Used when you ask Himawari to add a reminder or check one off.";
"NSMicrophoneUsageDescription" = "After you tap Start listening, Himawari listens around you and turns speech into text on this iPhone. When you dictate, your words are turned into text and sent to Himawari. Audio is deleted once transcribed.";
"NSSpeechRecognitionUsageDescription" = "Turn what Himawari hears into text on this iPhone.";
"NSMotionUsageDescription" = "Check whether your AirPods are in your ears, to tell that it is you calling. With Health and motion sensing on, it also records whether you're walking, running or driving, stored on your own server.";
"NSLocationWhenInUseUsageDescription" = "Records where you arrive and how long you stay, stored on your own server. When you tap Where I am, your current location is sent to Himawari.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Records where you arrive and how long you stay even when Himawari is closed, stored on your own server.";
"NSHealthShareUsageDescription" = "Reads steps, sleep, heart rate and workouts, stored on your own server.";
"NSHealthUpdateUsageDescription" = "Himawari only reads health data and never writes anything to the Health app.";
"NSPhotoLibraryUsageDescription" = "Records when and where new photos and screenshots were taken; those photos themselves are not uploaded. Photos you pick under + are sent to Himawari.";
