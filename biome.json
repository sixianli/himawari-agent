{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!.ci-output",
      "!!.agents/tasks",
      "!!.agents/reviews",
      "!!scripts/delivery-mode/packet-template",
      "!!scripts/delivery-mode/hermes/capture-build-source-inputs.template.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**/*.mjs", "scripts/**/*.js", "test/tooling/**/*.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    },
    {
      "includes": ["docs/assets/control-center/**/*.html"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "test/qualification/evidence/**",
        "test/fixtures/memory-evaluation/embeddings-*.json",
        "evals/owner-rule/*.json",
        "evals/memory-capture/*.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/agent-service/src/document-skill/a4.css"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["ci/rules/fixtures/unsafe.fixture.ts"],
      "linter": {
        "rules": {
          "security": {
            "noGlobalEval": "off"
          }
        }
      }
    },
    {
      "includes": [
        "docs/assets/architecture/system-overview.html",
        "docs/assets/control-center/2026-09-15-v4/source.html",
        "docs/assets/control-center/2026-09-15-v4/index.html",
        "docs/assets/control-center/2026-09-16-state-review-r3/source.html",
        "docs/assets/control-center/2026-09-16-state-review-r3/index.html",
        "docs/assets/control-center/2026-09-27-v5/source.html",
        "docs/assets/control-center/2026-09-27-v5/index.html"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "docs/assets/control-center/2026-09-10-v1/index.html",
        "docs/assets/control-center/2026-09-10-v1/source.html",
        "docs/assets/control-center/2026-10-26-v6/index.html",
        "docs/assets/control-center/2026-10-26-v6/mark-options.html",
        "docs/assets/control-center/2026-10-28-v8/desktop.dc.html",
        "docs/assets/control-center/2026-10-28-v8/phone.dc.html",
        "docs/assets/control-center/2026-10-28-v8/canvas.json",
        "docs/assets/control-center/2026-10-29-v11/prototype.html",
        "docs/assets/control-center/2026-10-29-v12/memory-page-prototype.html",
        "docs/assets/control-center/2026-10-30-v13/logo-growth-prototype.html",
        "docs/assets/brand-candidates/2026-10-30-logo/index.html"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
